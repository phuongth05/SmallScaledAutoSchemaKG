# Select "remote" only in the client environment (for example, Colab).
LLM_BACKEND=remote
REMOTE_LLM_BASE_URL=https://YOUR-POD-ID-8000.proxy.runpod.net/v1
REMOTE_LLM_API_KEY=replace-with-a-long-random-secret

# RunPod server environment. Use the same secret as REMOTE_LLM_API_KEY.
VLLM_API_KEY=replace-with-a-long-random-secret
MODEL_ID=Qwen/Qwen3.5-2B
MODEL_REVISION=15852e8c16360a2fea060d615a32b45270f8a8fc
MAX_MODEL_LEN=4096
GPU_MEMORY_UTILIZATION=0.90
